# ---------------------------------------------------------------------------
# Profesor para el dataset sintético (OpenAI-compatible)
# ---------------------------------------------------------------------------
# La clave NUNCA se commitea. Copiá este archivo a .env y completá la tuya.
# OpenCode Console / Go (OpenAI-compatible):
TEACHER_API_KEY=
TEACHER_BASE_URL=https://opencode.ai/inference/openai/v1
TEACHER_MODEL=deepseek-v4.1-flash
# Alternativa DeepSeek directo:
# TEACHER_BASE_URL=https://api.deepseek.com/v1
# TEACHER_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Modelo base y artefactos
# ---------------------------------------------------------------------------
JUNIPERUS_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
JUNIPERUS_MODEL_PATH=models/juniperus-v1.gguf
JUNIPERUS_ADAPTER=models/juniperus-lora
JUNIPERUS_MERGED_DIR=models/juniperus-merged

# ---------------------------------------------------------------------------
# Sidecar local (`juniperus serve`)
# ---------------------------------------------------------------------------
JUNIPERUS_HOST=127.0.0.1
JUNIPERUS_PORT=7767
# Opcional. Si está, /route exige Bearer token. Oni lo reenvía como
# ONI_JUNIPERUS_TOKEN.
JUNIPERUS_TOKEN=

# ---------------------------------------------------------------------------
# Export GGUF
# ---------------------------------------------------------------------------
# Checkout de llama.cpp con convert_hf_to_gguf.py y llama-quantize.
LLAMA_CPP_DIR=
